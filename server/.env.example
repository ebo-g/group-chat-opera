OPENAI_API_KEY=
# stub (offline fake model) | snowflake
LLM_PROVIDER=snowflake
# Cortex model name
LLM_MODEL=claude-sonnet-4-5
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=

# --- ElevenLabs text-to-speech (optional: without these the frontend uses synth voices) ---
ELEVENLABS_API_KEY=
# Optional model override (default eleven_multilingual_v2)
# ELEVENLABS_MODEL=
# Voice lookup order for each line: (1) by the cast member's voice type, if set below,
# (2) else by position (C1..C5). Set the 5 voice-type vars to cast by role, the 5
# positional vars as a fallback, or both. The frontend sends {text, castId, voice}.
#   SOPRANO = bright female lead / diva      ALTO = warm female, confidante / comic
#   TENOR = male hero or comic lead          BARITONE = villain / rival
#   BASS = deep, gruff: servant, father, chorus
ELEVENLABS_VOICE_SOPRANO=
ELEVENLABS_VOICE_ALTO=
ELEVENLABS_VOICE_TENOR=
ELEVENLABS_VOICE_BARITONE=
ELEVENLABS_VOICE_BASS=
# Positional fallback. castIds are c1..c5 in every libretto, whoever the characters are.
# The libretto prompt lists the most active chatter first, so c1 is usually the lead.
# Paste voice IDs from your ElevenLabs voice library; pick a type per slot:
#   C1 = lead / tragic hero or heroine: expressive, bright, powerful (soprano / tenor)
#   C2 = second lead / rival: strong, dramatic (tenor / mezzo)
#   C3 = villain: dark, gravelly baritone
#   C4 = comic relief / confidante: lighter, quick, playful (alto)
#   C5 = scheming servant / chorus: warm, deep bass
ELEVENLABS_VOICE_C1=
ELEVENLABS_VOICE_C2=
ELEVENLABS_VOICE_C3=
ELEVENLABS_VOICE_C4=
ELEVENLABS_VOICE_C5=
