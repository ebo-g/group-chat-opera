OPENAI_API_KEY=
# stub (offline fake model) | snowflake
LLM_PROVIDER=snowflake
# Cortex model name
LLM_MODEL=claude-sonnet-4-5
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=

# --- ElevenLabs text-to-speech (optional: without these the frontend uses synth voices) ---
ELEVENLABS_API_KEY=
# Optional model override (default eleven_multilingual_v2)
# ELEVENLABS_MODEL=
# Voices are POSITIONAL: castIds are c1..c5 in every libretto, whoever the characters are.
# The libretto prompt lists the most active chatter first, so c1 is usually the lead.
# Paste voice IDs from your ElevenLabs voice library; pick a type per slot:
#   C1 = lead / tragic hero or heroine: expressive, bright, powerful (soprano / tenor)
#   C2 = second lead / rival: strong, dramatic (tenor / mezzo)
#   C3 = villain: dark, gravelly baritone
#   C4 = comic relief / confidante: lighter, quick, playful (alto)
#   C5 = scheming servant / chorus: warm, deep bass
ELEVENLABS_VOICE_C1=
ELEVENLABS_VOICE_C2=
ELEVENLABS_VOICE_C3=
ELEVENLABS_VOICE_C4=
ELEVENLABS_VOICE_C5=
